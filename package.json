{
  "name": "open-question-labeling-studio",
  "version": "0.3.0",
  "description": "开放题文本、五模型回复、排序与截图的本地记录库",
  "main": "electron/main.cjs",
  "author": "Open Question Labeling Studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node --test tests/domain.test.mjs tests/shared-library.test.mjs tests/backup-stream.test.mjs tests/multi-import.test.mjs tests/updates.test.cjs",
    "start": "electron . --production",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "share": "npm run dist && node scripts/package-share.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "dist:installer": "npm run build && electron-builder --win nsis --publish never",
    "release:manifest": "node scripts/create-update-manifest.cjs",
    "repo:prepare": "node scripts/prepare-repository.cjs",
    "pretest": "node scripts/prepare-test-directories.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "vite": "^8.3.4",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.openquestionlabeling.studio",
    "productName": "开放题标注工作台",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/domain.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "OpenQuestionStudio-${version}.exe"
    },
    "extraResources": [
      {
        "from": "distribution/installed-mode.json",
        "to": "installed-mode.json"
      },
      {
        "from": "distribution/update-source.json",
        "to": "update-source.json"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "开放题记录库",
      "uninstallDisplayName": "开放题记录库",
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenQuestionStudio-Setup-${version}.exe",
      "include": "build/installer.nsh"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shijinxiang/open-prompt.git"
  },
  "homepage": "https://github.com/shijinxiang/open-prompt",
  "bugs": {
    "url": "https://github.com/shijinxiang/open-prompt/issues"
  }
}
